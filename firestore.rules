rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function sameVenue(venueId) { return signedIn() && request.auth.token.venueId == venueId; }
    function isStaff(venueId) {
      return sameVenue(venueId)
        && request.auth.token.role == 'staff'
        && request.auth.token.staffVersion == get(/databases/$(database)/documents/venues/$(venueId)).data.staffVersion;
    }
    function isDisplay(venueId) { return sameVenue(venueId) && request.auth.token.role == 'display'; }
    function validDisplayVersion(venueId) {
      return isDisplay(venueId)
        && request.auth.token.displayVersion == get(/databases/$(database)/documents/venues/$(venueId)).data.displayVersion;
    }
    function canRead(venueId) { return isStaff(venueId) || validDisplayVersion(venueId); }
    function validVenue() {
      return request.resource.data.keys().hasOnly([
        'name', 'currency', 'backgroundColor', 'accentColor', 'logoPath',
        'pageDurationSeconds', 'displayScalePercent', 'displayVersion', 'staffVersion', 'updatedAt', 'updatedBy'
      ])
      && request.resource.data.name is string
      && request.resource.data.name.size() >= 1
      && request.resource.data.name.size() <= 80
      && request.resource.data.currency == 'RUB'
      && request.resource.data.backgroundColor.matches('^#[0-9A-Fa-f]{6}$')
      && request.resource.data.accentColor.matches('^#[0-9A-Fa-f]{6}$')
      && request.resource.data.pageDurationSeconds is int
      && request.resource.data.pageDurationSeconds >= 5
      && request.resource.data.pageDurationSeconds <= 60
      && (!request.resource.data.keys().hasAny(['displayScalePercent'])
        || (request.resource.data.displayScalePercent is int
          && request.resource.data.displayScalePercent >= 80
          && request.resource.data.displayScalePercent <= 160))
      && request.resource.data.displayVersion == resource.data.displayVersion
      && request.resource.data.staffVersion == resource.data.staffVersion;
    }
    function validCategory(venueId) {
      return request.resource.data.keys().hasOnly(['venueId', 'name', 'sortOrder', 'updatedAt', 'updatedBy'])
        && request.resource.data.venueId == venueId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50
        && request.resource.data.sortOrder is int;
    }
    function validItem(venueId) {
      return request.resource.data.keys().hasOnly([
        'venueId', 'categoryId', 'name', 'priceMinor', 'sortOrder',
        'isAvailable', 'updatedAt', 'updatedBy'
      ])
        && request.resource.data.venueId == venueId
        && request.resource.data.categoryId is string
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 80
        && request.resource.data.priceMinor is int
        && request.resource.data.priceMinor >= 0
        && request.resource.data.priceMinor <= 99999999
        && request.resource.data.sortOrder is int
        && request.resource.data.isAvailable is bool;
    }

    match /venues/{venueId} {
      allow read: if canRead(venueId);
      allow create, delete: if false;
      allow update: if isStaff(venueId) && validVenue();
    }
    match /categories/{categoryId} {
      allow read: if canRead(resource.data.venueId);
      allow create: if isStaff(request.resource.data.venueId) && validCategory(request.resource.data.venueId);
      allow update: if isStaff(resource.data.venueId)
        && request.resource.data.venueId == resource.data.venueId
        && validCategory(resource.data.venueId);
      allow delete: if isStaff(resource.data.venueId);
    }
    match /items/{itemId} {
      allow read: if canRead(resource.data.venueId);
      allow create: if isStaff(request.resource.data.venueId) && validItem(request.resource.data.venueId);
      allow update: if isStaff(resource.data.venueId)
        && request.resource.data.venueId == resource.data.venueId
        && validItem(resource.data.venueId);
      allow delete: if isStaff(resource.data.venueId);
    }

    match /venueCodes/{document=**} { allow read, write: if false; }
    match /displayTokens/{document=**} { allow read, write: if false; }
    match /loginAttempts/{document=**} { allow read, write: if false; }
    match /venueAccess/{document=**} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
