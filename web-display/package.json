{
  "name": "interactive-food-menu-display",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:legacy-connect && tsc -b && vite build",
    "build:legacy-connect": "esbuild src/legacy-connect-entry.js --bundle --platform=browser --target=es2015 --format=iife --outfile=public/legacy-connect.js && node scripts/transpile-legacy-connect.cjs",
    "test": "vitest run",
    "preview": "vite preview",
    "tv": "npm run build && vite preview --host 0.0.0.0 --port 5174 --strictPort"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-legacy": "^7.2.1",
    "jsdom": "^26.1.0",
    "terser": "^5.51.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
