# Add these two exact-host server blocks inside nginx.conf's http { ... }.
# They win over the Jellyfin wildcard block, so Jellyfin remains available.
server {
    listen 80;
    server_name api.foodmenu.cloudopragopa.online;

    location /.well-known/acme-challenge/ {
        root C:/nginx-1.31.1/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name api.foodmenu.cloudopragopa.online;

    # This certificate must be issued for api.foodmenu.cloudopragopa.online.
    ssl_certificate     C:/Certbot/live/api.foodmenu.cloudopragopa.online/fullchain.pem;
    ssl_certificate_key C:/Certbot/live/api.foodmenu.cloudopragopa.online/privkey.pem;
    ssl_session_cache shared:SSL:1m;
    ssl_session_timeout 5m;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    client_max_body_size 5m;

    location /v1/ {
        proxy_pass http://127.0.0.1:8089;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8091/health;
        proxy_set_header Host $http_host;
    }

    location = /ready {
        proxy_pass http://127.0.0.1:8091/ready;
        proxy_set_header Host $http_host;
    }

    # Appwrite Console stays reachable only from the server via localhost.
    location / {
        return 404;
    }
}
