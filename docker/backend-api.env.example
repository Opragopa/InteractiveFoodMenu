# Copy to .env.backend on the server. Never commit the real file.
PUBLIC_URL=https://api.foodmenu.cloudopragopa.online:8443
DISPLAY_BASE_URL=https://menu.example.com
CORS_ORIGINS=https://menu.example.com
PORT=3000

# Appwrite is installed separately by the official self-hosted installer.
# The Appwrite installer enables forced HTTPS. The API connects over the
# host-only TLS port; its locally generated certificate is accepted only here.
APPWRITE_ENDPOINT=https://host.docker.internal:8433/v1
APPWRITE_SELF_SIGNED=true
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=interactive-food-menu
APPWRITE_BUCKET_ID=venue-assets

# Generate independent random values of at least 32 characters.
BACKEND_SESSION_SECRET=
BACKEND_HUB_ACCESS_KEY=
