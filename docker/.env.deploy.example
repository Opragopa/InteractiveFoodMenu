# Copy to .env.deploy on the Windows server. Do not commit the copy.
# Run: docker compose --env-file .env.deploy up --build -d
MENU_PROXY_PORT=8088

# Public HTTPS address served by the existing host Nginx.
VITE_DISPLAY_BASE_URL=https://menu.example.com

# Firebase web configuration from Firebase Console -> Project settings -> Your apps.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
