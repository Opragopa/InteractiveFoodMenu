# Install this as a new server block in the existing Windows Nginx instance.
# Replace menu.example.com and the certificate paths. It does not modify the
# Jellyfin block: Nginx still owns 80/443 and Docker listens only on 127.0.0.1:8088.
server {
    listen 80;
    server_name menu.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name menu.example.com;

    ssl_certificate     C:/nginx/conf/certs/menu.example.com/fullchain.pem;
    ssl_certificate_key C:/nginx/conf/certs/menu.example.com/privkey.pem;

    client_max_body_size 5m;

    location /tv/ {
        proxy_pass http://127.0.0.1:8091/tv/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
        gzip off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
    }

    location ~ ^/api/display/(legacy/|pairings/) {
        access_log off;
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 75s;
        gzip off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8091;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_read_timeout 75s;
        gzip off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location /api/venue-assets/ {
        proxy_pass http://127.0.0.1:8091/api/venue-assets/;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
        gzip off;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    # Older path-style screen links can contain credentials in the path.
    location ~ ^/display/ {
        access_log off;
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 75s;
        gzip off;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host $host;
    }
}
