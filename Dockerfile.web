# Build the static React/TV application without requiring Node on the host.
FROM node:22-bookworm-slim AS build

WORKDIR /srv/web

COPY web-display/package.json web-display/package-lock.json ./
RUN npm ci

COPY web-display ./

ARG VITE_FIREBASE_API_KEY
ARG VITE_FIREBASE_AUTH_DOMAIN
ARG VITE_FIREBASE_PROJECT_ID
ARG VITE_FIREBASE_STORAGE_BUCKET
ARG VITE_FIREBASE_APP_ID
ARG VITE_FIREBASE_FUNCTIONS_REGION=europe-west1
ARG VITE_RECAPTCHA_ENTERPRISE_SITE_KEY
ARG VITE_DISPLAY_BASE_URL
ARG VITE_USE_EMULATORS=false
ARG VITE_DEMO_MODE=false

ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY \
    VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN \
    VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID \
    VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET \
    VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID \
    VITE_FIREBASE_FUNCTIONS_REGION=$VITE_FIREBASE_FUNCTIONS_REGION \
    VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=$VITE_RECAPTCHA_ENTERPRISE_SITE_KEY \
    VITE_DISPLAY_BASE_URL=$VITE_DISPLAY_BASE_URL \
    VITE_USE_EMULATORS=$VITE_USE_EMULATORS \
    VITE_DEMO_MODE=$VITE_DEMO_MODE

RUN npm run build

FROM nginx:1.28-alpine

COPY docker/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/web/dist /usr/share/nginx/html

EXPOSE 8080
