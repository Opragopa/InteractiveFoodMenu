# Build the static React/TV application without requiring Node on the host.
FROM node:22-bookworm-slim AS build

WORKDIR /srv/web

COPY web-display/package.json web-display/package-lock.json ./
RUN npm ci

COPY web-display ./

ARG VITE_BACKEND_API_URL=/api

ENV VITE_BACKEND_API_URL=$VITE_BACKEND_API_URL

RUN npm run build

FROM nginx:1.28-alpine

COPY docker/nginx/web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /srv/web/dist /usr/share/nginx/html

EXPOSE 8080
