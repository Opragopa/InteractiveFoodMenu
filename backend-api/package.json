{
  "name": "interactive-food-menu-backend-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "bootstrap": "node dist/bootstrap.js",
    "operator:create": "node dist/createOperator.js",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "npm run build && node --test dist/*.test.js",
    "coverage": "npm run build && c8 --all --src src --exclude '**/*.test.*' --exclude 'src/bootstrap.ts' --reporter=text --reporter=html node --test dist/*.test.js",
    "integration": "npm run build && node --test dist/integration.test.js",
    "mutation": "stryker run",
    "migrate:appwrite": "node dist/migrateAppwrite.js",
    "test:postgres": "npm run build && node --test dist/postgres.test.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fontkit": "^2.0.4",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "node-appwrite": "^29.0.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "redis": "^6.3.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/fontkit": "^2.0.9",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "c8": "^12.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2"
  }
}
