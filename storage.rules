rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function venueDocument(venueId) {
      return firestore.get(/databases/(default)/documents/venues/$(venueId));
    }
    function validStaff(venueId) {
      return request.auth != null
        && request.auth.token.venueId == venueId
        && request.auth.token.role == 'staff'
        && request.auth.token.staffVersion == venueDocument(venueId).data.staffVersion;
    }
    function validDisplay(venueId) {
      return request.auth != null
        && request.auth.token.venueId == venueId
        && request.auth.token.role == 'display'
        && request.auth.token.displayVersion == venueDocument(venueId).data.displayVersion;
    }
    match /venues/{venueId}/logo/{fileName} {
      allow read: if validStaff(venueId) || validDisplay(venueId);
      allow write: if validStaff(venueId)
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
